# Copie para .env e preencha. NUNCA commite o .env real.

# Banco de dados — Supabase (Project Settings > Database > Connection string).
# Use a "Session pooler" (porta 5432) nos dois campos: funciona para o app E para migrations.
# Otimização futura (P1): DATABASE_URL no transaction pooler (6543) e DIRECT_URL na conexão direta.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@HOST_DO_PAINEL:5432/postgres"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@HOST_DO_PAINEL:5432/postgres"

# Opcional: um segundo projeto Supabase (free, pode ser outra região) usado SÓ como
# "shadow database" do `prisma migrate dev`. Sem ele, use `npm run db:migrate`
# (create-only + deploy — não usa shadow). Ver README > Banco de dados.
SHADOW_DATABASE_URL=""

# Auth (Better Auth) — obrigatório desde a tarefa 003.
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL pública do app (links de e-mail e validação de origem). Em produção: o domínio real.
BETTER_AUTH_URL="http://localhost:3000"

# E-mail transacional (Resend) — tarefas 003/009/015.
# Sem a chave, os e-mails (reset de senha, convites) aparecem no console do servidor.
RESEND_API_KEY=""
EMAIL_FROM="Tervian <nao-responda@tervian.dev>"

# Observabilidade — tarefa 013
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
